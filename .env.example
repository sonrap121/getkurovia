# PostgreSQL connection used by Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Admin panel password (/admin). Defaults to "kurovia-admin-2026" when unset — change this in production!
ADMIN_PASSWORD=

# Set to "true" when the site is served over HTTPS (getkurovia.com) so the admin cookie is Secure.
ADMIN_COOKIE_SECURE=true

# Payments: when STRIPE_SECRET_KEY is present the checkout switches from sandbox mode to live mode.
# Wire your provider in src/lib/payments.ts (authorizePayment).
STRIPE_SECRET_KEY=
